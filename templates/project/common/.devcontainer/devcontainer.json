// Hardened agent sandbox. Works with Cursor and VS Code ("Reopen in Container").
// Runs on an Ubuntu Docker host: Cursor Remote-SSH to the server, then Reopen in Container.
// Agents (Claude Code, Codex) run in here, never directly on the workstation or server.
{
  "name": "{{PROJECT_NAME}}",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "runArgs": [
    "--cap-drop=ALL",
    "--security-opt=no-new-privileges:true",
    "--pids-limit=1024",
    "--memory=8g",
    // Internet allowed, internal network blocked except allow-listed hosts.
    // Created by server/aos-egress.sh on the Docker host.
    "--network=aos-agents"
    // Phase 3, if gVisor is installed on the host: "--runtime=runsc"
  ],
  // Runs on the server before the container starts: makes sure the personal rules file
  // exists, because a bind mount of a missing path fails.
  "initializeCommand": "mkdir -p \"$HOME/.config/aos/agents\" && touch \"$HOME/.config/aos/agents/AGENTS.md\"",
  // Tool logins and session history persist per user and project in named volumes.
  // Personal rules (shared by every project) are mounted read-only from the server.
  "mounts": [
    "source=${localEnv:HOME}/.config/aos/agents,target=/home/vscode/.aos,type=bind,readonly",
    "source=${localEnv:USER}-{{PROJECT_SLUG}}-claude,target=/home/vscode/.claude,type=volume",
    "source=${localEnv:USER}-{{PROJECT_SLUG}}-codex,target=/home/vscode/.codex,type=volume"
  ],
  // On-prem AI settings come from the server user's environment (~/.profile) so nothing
  // internal is committed.
  "containerEnv": {
    "AOS_ONPREM_URL": "${localEnv:AOS_ONPREM_URL}",
    "AOS_ONPREM_API_KEY": "${localEnv:AOS_ONPREM_API_KEY}",
    "AOS_ONPREM_MODEL": "${localEnv:AOS_ONPREM_MODEL}"
  },
  "postCreateCommand": "npm install -g @openai/codex",
  "customizations": {
    "vscode": {
      "extensions": ["editorconfig.editorconfig"]
    }
  }
}
